{
  "description": "efficiency — refuse to end a turn while an approved run has work left, hold the spend ceiling inside the turn as well as at its end, let non-destructive Bash run without a permission prompt, and carry the autonomy charter into projects that adopted the framework",
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/autopilot-pretool.py\"",
            "timeout": 20,
            "statusMessage": "Checking the spend ceiling and the command..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/autopilot-stop.py\"",
            "timeout": 1200,
            "statusMessage": "Checking the run before ending the turn..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/prompt-reminder.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
